"""
src/retrieval/dense.py

Embeds every chunk in data/processed/chunks.jsonl using a sentence-transformers
model, then builds a FAISS index for dense similarity search.

Model is swappable: uncomment the line for the model you want to use.
Only one MODEL_NAME line should be active at a time.

Usage:
    python src/retrieval/dense.py

Output:
    data/processed/faiss_index/index.faiss   (the FAISS index itself)
    data/processed/faiss_index/chunk_ids.json (ordered list mapping index
                                                position -> chunk_id, since
                                                FAISS only stores vectors,
                                                not metadata)
"""

import json
from pathlib import Path

import faiss
import numpy as np
from sentence_transformers import SentenceTransformer

# ---------------------------------------------------------------------------
# MODEL SELECTION
# Uncomment exactly one. Swapping models = comment/uncomment one line.
# ---------------------------------------------------------------------------

MODEL_NAME = "BAAI/bge-base-en-v1.5"
# MODEL_NAME = "sentence-transformers/all-MiniLM-L6-v2"
# MODEL_NAME = "intfloat/e5-base-v2"
# MODEL_NAME = "BAAI/bge-large-en-v1.5"

# BGE models recommend prefixing QUERIES (not passages/chunks) with an
# instruction for retrieval tasks. Leave as "" for models that don't use one
# (e.g. MiniLM). Only applies when embedding queries at retrieval time, not
# when embedding chunks here.
QUERY_INSTRUCTION_PREFIX = "Represent this sentence for searching relevant passages: "

CHUNKS_PATH = "data/processed/chunks.jsonl"
INDEX_DIR = "data/processed/faiss_index"

# ---------------------------------------------------------------------------


def load_chunks(chunks_path: str) -> list[dict]:
    """Loads all chunk records from the JSONL file."""
    chunks = []
    with open(chunks_path, "r", encoding="utf-8") as f:
        for line in f:
            chunks.append(json.loads(line))
    return chunks


def embed_chunks(chunks: list[dict], model: SentenceTransformer) -> np.ndarray:
    """
    Embeds every chunk's text. Chunks (passages) are embedded as-is, no
    instruction prefix — only queries get the instruction prefix at
    retrieval time.
    """
    texts = [chunk["text"] for chunk in chunks]
    print(f"Embedding {len(texts)} chunks with {MODEL_NAME}...")
    embeddings = model.encode(
        texts,
        show_progress_bar=True,
        convert_to_numpy=True,
        normalize_embeddings=True,  # normalize so we can use inner product = cosine similarity
    )
    return embeddings.astype("float32")


def build_faiss_index(embeddings: np.ndarray) -> faiss.Index:
    """
    Builds a flat (exact, brute-force) FAISS index using inner product.
    Since embeddings are normalized, inner product is equivalent to cosine
    similarity. Flat index is exact and simple — fine for a benchmark-sized
    corpus (thousands of chunks); would need an approximate index (IVF, HNSW)
    at much larger scale.
    """
    dimension = embeddings.shape[1]
    index = faiss.IndexFlatIP(dimension)
    index.add(embeddings)
    return index


def embed_query(query: str, model: SentenceTransformer) -> np.ndarray:
    """
    Embeds a single query string for retrieval-time search. Applies the
    query instruction prefix (used by BGE-style models); harmless no-op
    for models that don't need one if QUERY_INSTRUCTION_PREFIX is "".
    """
    prefixed = QUERY_INSTRUCTION_PREFIX + query
    embedding = model.encode(
        [prefixed],
        convert_to_numpy=True,
        normalize_embeddings=True,
    )
    return embedding.astype("float32")


def build_and_save_index(chunks_path: str = CHUNKS_PATH, index_dir: str = INDEX_DIR) -> None:
    """
    Full pipeline: load chunks, embed them, build the FAISS index, and save
    both the index and the chunk_id ordering to disk.
    """
    model = SentenceTransformer(MODEL_NAME)

    chunks = load_chunks(chunks_path)
    if not chunks:
        print(f"No chunks found at {chunks_path}. Run the chunker first.")
        return

    embeddings = embed_chunks(chunks, model)
    index = build_faiss_index(embeddings)

    out_dir = Path(index_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    faiss.write_index(index, str(out_dir / "index.faiss"))

    # FAISS only stores vectors by position (0, 1, 2, ...), not metadata.
    # Save the ordered list of chunk_ids so a search result position can be
    # mapped back to the actual chunk it corresponds to.
    chunk_ids = [chunk["chunk_id"] for chunk in chunks]
    with open(out_dir / "chunk_ids.json", "w", encoding="utf-8") as f:
        json.dump(chunk_ids, f, indent=2)

    print(f"\nSaved FAISS index ({index.ntotal} vectors, dim={embeddings.shape[1]}) to {index_dir}")
    print(f"Model used: {MODEL_NAME}")


if __name__ == "__main__":
    build_and_save_index()